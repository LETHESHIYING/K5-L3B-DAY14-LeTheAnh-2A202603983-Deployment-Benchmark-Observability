# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng:  cp .env.example .env   (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development

# Bảo mật: client gửi header X-API-Key trùng giá trị này. ĐỔI trước khi deploy.
AGENT_API_KEY=change-me

# Redis (rate limit + cost guard). Khi chạy docker compose thì đã được đặt sẵn.
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
